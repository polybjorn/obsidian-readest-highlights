{
  "name": "obsidian-readest-highlights",
  "version": "1.9.0",
  "description": "Import highlights and annotations from Readest into Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "preview": "npm run build && node preview.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "gallery": "tsx --tsconfig tsconfig.test.json tests/gallery.ts",
    "demo-vault": "tsx --tsconfig tsconfig.test.json tests/demo-vault.ts",
    "record-sync": "npm run build && node scripts/record-sync.mjs"
  },
  "keywords": [
    "obsidian",
    "readest",
    "highlights",
    "annotations"
  ],
  "license": "MIT",
  "overrides": {
    "yaml": "^2.8.3",
    "flatted": "^3.4.0",
    "ajv@^6": "^6.14.0",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "minimatch@^3": {
      ".": "^3.1.3",
      "brace-expansion": "^1.1.21"
    },
    "brace-expansion": "^5.0.8",
    "moment": "^2.31.0",
    "glob@^13": "^14.0.4"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^26.6.4",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "esbuild": "0.28.2",
    "eslint-plugin-obsidianmd": "0.5.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "obsidian-launcher": "3.5.0",
    "tslib": "2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0",
    "webdriverio": "10.2.0"
  }
}
